<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">LagerverwaltungTool</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="inventar">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Inventar
            </NavLink>
        </div>

        <AuthorizeView Roles="Admin">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="genehmigungen">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Genehmigungen
                </NavLink>
            </div>
        </AuthorizeView>

        <AuthorizeView Roles="Lernende, Admin">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="Ausleihen">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Meine Ausleihen
                </NavLink>
            </div>
        </AuthorizeView>

         <AuthorizeView Roles="Admin">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="changelog">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Change-Log
                </NavLink>
            </div>
        </AuthorizeView>

         <AuthorizeView Roles="Admin">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="user">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Users
                </NavLink>
            </div>
        </AuthorizeView>

        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3 mt-3 text-white">
                    <div>@context.User.Identity?.Name</div>
                    <small>@context.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</small>
                    <form action="/logout" method="post" class="mt-2">
                        <button type="submit" class="btn btn-outline-light btn-sm">Logout</button>
                    </form>
                </div>
            </Authorized>
        </AuthorizeView>
    </nav>
</div>