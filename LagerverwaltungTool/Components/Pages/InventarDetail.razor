@page "/inventar/{Id:int}"
@using Microsoft.EntityFrameworkCore
@using LagerverwaltungTool.Data
@using LagerverwaltungTool.Model
@inject AppDbContext Db

<PageTitle>Artikel-Details</PageTitle>

<a href="inventar">← Zurück zum Inventar</a>

@if (loading)
{
    <p>Lade...</p>
}
else if (artikel == null)
{
    <p>Artikel nicht gefunden.</p>
}
else
{
    <h4 class="mt-3">ART-@artikel.ART_ID.ToString("D4") – @artikel.Bezeichnung</h4>

    <div class="row mt-3">
        <div class="col-md-6 mb-3">
            <div class="card h-100">
                <div class="card-header">Netzwerk</div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Hostname</dt>
                        <dd class="col-sm-8">@artikel.Hostname</dd>

                        <dt class="col-sm-4">IP-Adresse</dt>
                        <dd class="col-sm-8">@artikel.IPAdresse</dd>

                        <dt class="col-sm-4">Statisch</dt>
                        <dd class="col-sm-8">@(artikel.IstStatisch ? "Ja" : "Nein")</dd>

                        <dt class="col-sm-4">MAC-Adresse</dt>
                        <dd class="col-sm-8">@artikel.MACAdresse</dd>

                        <dt class="col-sm-4">Netz</dt>
                        <dd class="col-sm-8">@artikel.Netz</dd>
                    </dl>
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-3">
            <div class="card h-100">
                <div class="card-header">Verwaltung</div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Kategorie</dt>
                        <dd class="col-sm-8">@artikel.Kategorie.Name</dd>

                        <dt class="col-sm-4">Status</dt>
                        <dd class="col-sm-8">@artikel.Status</dd>

                        <dt class="col-sm-4">Ort</dt>
                        <dd class="col-sm-8">@artikel.Ort</dd>

                        <dt class="col-sm-4">Besitzer/in</dt>
                        <dd class="col-sm-8">@artikel.Besitzer?.Benutzername</dd>

                        <dt class="col-sm-4">Notizen</dt>
                        <dd class="col-sm-8">@artikel.Notizen</dd>

                        <dt class="col-sm-4">Erfassungsdatum</dt>
                        <dd class="col-sm-8">@artikel.Erfassungsdatum.ToString("dd.MM.yyyy")</dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private ArtikelModel? artikel;
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        artikel = await Db.Artikel
            .Include(a => a.Kategorie)
            .Include(a => a.Besitzer)
            .FirstOrDefaultAsync(a => a.ART_ID == Id);
        loading = false;
    }
}