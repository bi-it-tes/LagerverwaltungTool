@page "/genehmigungen"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using LagerverwaltungTool.Data
@using LagerverwaltungTool.Model
@inject AppDbContext Db
@inject ChangeLogService Log
@attribute [Authorize(Roles = "Admin")]


<PageTitle>Genehmigungen</PageTitle>

<h3>Genehmigungsanfragen</h3>

@if (antraege == null)
{
    <p>Lade...</p>
}
else if (antraege.Count == 0)
{
    
    <p>Keine Anträge vorhanden.</p>
}
else
{       
    <table class="table table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Antragsteller</th>
                <th>Artikel</th>
                <th>Begründung</th>  
                <th>Anzahl</th>  
                <th>Zeitraum</th>  
                <th>Status</th>  
                <th>Erstellt</th>  
                <th>Aktion</th>  
            </tr>
        </thead>
        <tbody>
            @foreach (var a in antraege)
            {
                <tr>
                    <td>REQ-@a.REQ_ID.ToString("D4")</td>
                    <td>@a.User.Benutzername</td>
                    <td>@string.Join(", ", a.Artikel.Select(x => x.Artikel.Bezeichnung))</td>
                    <td>@a.Begruendung</td>
                    <td>@a.Artikel.Sum(x => x.Anzahl)</td>
                    <td>@Zeitraum(a)</td>
                    <td>@a.Status</td>
                    <td>@a.Erstellungsdatum.ToString("dd.MM.yyyy")</td>
                    <td>
                        @if (a.Status == AntragStatus.Ausstehend)
                        {
                            <button class="btn btn-success btn-sm me-1" @onclick="() => Genehmigen(a)">Genehmigen</button>
                            <button class="btn btn-danger btn-sm" @onclick="() => Ablehnen(a)">Ablehnen</button>
                        }
                        else if (a.Status == AntragStatus.Genehmigt && a.RueckgabeDatum == null)
                        {
                            
                            <input class="form-control form-control-sm mb-1" placeholder="Notiz zur Rückgabe"
                                   @bind="rueckgabeNotizen[a.REQ_ID]" />
                            <button class="btn btn-primary btn-sm" @onclick="() => Zurueckgeben(a)">Rückgabe erfassen</button>
                        }
                        else if (a.RueckgabeDatum != null)
                        {
                             <small>Zurückgegeben am @a.RueckgabeDatum.Value.ToString("dd.MM.yyyy")</small>
                            @if (!string.IsNullOrEmpty(a.RueckgabeNotizen))
                            {
                                <br /><small>@a.RueckgabeNotizen</small>
                            }
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}


@code {

    private Dictionary<int, string> rueckgabeNotizen = new();
    private List<AusleihAntragModel>? antraege;

    protected override async Task OnInitializedAsync()
    {
        antraege = await Db.AusleihAntraege
            .Include(a => a.User)
            .Include(a => a.Artikel)
                .ThenInclude(aa => aa.Artikel)
            .OrderByDescending(a => a.Erstellungsdatum)
            .ToListAsync();

        foreach (var a in antraege)
        {
            rueckgabeNotizen[a.REQ_ID] = string.Empty;
        }
    }

    private static string Zeitraum(AusleihAntragModel a) => 
        a.Artikel.Any()
            ? $"{a.Artikel.Min(x => x.Von):dd.MM.yyyy} - {a.Artikel.Max(x => x.Bis):dd.MM.yyyy}"
            : "-";

    private async Task Genehmigen(AusleihAntragModel a)
    {
        if (a.Status != AntragStatus.Ausstehend) return;

        a.Status = AntragStatus.Genehmigt;
        foreach (var aa in a.Artikel)
            aa.Artikel.Status = ArtikelStatus.Ausgeliehen;

        await Db.SaveChangesAsync();
        await Log.LogAsync("AusleihAntraege", a.REQ_ID, "Genehmigt");
    }
    


    private async Task Ablehnen(AusleihAntragModel a)
    {
        if (a.Status != AntragStatus.Ausstehend) return;

        a.Status = AntragStatus.Abgelehnt;
        foreach (var aa in a.Artikel)
            aa.Artikel.Status = ArtikelStatus.Verfuegbar;

        await Db.SaveChangesAsync();
        await Log.LogAsync("AusleihAntraege", a.REQ_ID, "Abgelehnt");
    }
   


    private async Task Zurueckgeben(AusleihAntragModel a)
    {
        if (a.Status != AntragStatus.Genehmigt || a.RueckgabeDatum != null) return;
        a.RueckgabeDatum = DateTime.Now;
        a.RueckgabeNotizen = string.IsNullOrWhiteSpace(rueckgabeNotizen[a.REQ_ID])
        ? null
        : rueckgabeNotizen[a.REQ_ID];
        foreach (var aa in a.Artikel)
            aa.Artikel.Status = ArtikelStatus.Verfuegbar;
        await Db.SaveChangesAsync();
        await Log.LogAsync("AusleihAntraege", a.REQ_ID, "Rückgabe erfasst", a.RueckgabeNotizen);
    }
}
